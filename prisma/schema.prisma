generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (exactly as defined in the shared backend/mobile contract)
// ---------------------------------------------------------------------------

enum Mode {
  PERSONAL
  BUSINESS
}

enum ContactModeTag {
  PERSONAL
  BUSINESS
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  OTHER
}

enum Relationship {
  FAMILY
  FRIEND
  COLLEAGUE
  OTHER
}

enum BusinessSegment {
  VIP
  RECENT_BUYER
  REGULAR
}

enum CampaignType {
  AUTOMATED_RECURRING
  PROMOTIONAL
  ONE_TIME
  MILESTONE
}

enum ScheduleFrequency {
  WEEKLY
  MONTHLY
  DATE_RANGE
  IMMEDIATE
}

enum AudienceSegment {
  ALL
  VIP
  CELEBRANTS
  RECENT_BUYERS
}

enum CampaignTone {
  PROMOTIONAL
  WARM_FRIENDLY
  URGENT_DISCOUNT
  PROFESSIONAL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum Channel {
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionTier {
  TRIAL
  FREE
  PAID
}

// Not part of the enum list in the contract's data-model excerpt, but required to type
// Contact.source ("MANUAL|SYNCED") without resorting to a bare String. Values match exactly.
enum ContactSource {
  MANUAL
  SYNCED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id               String           @id @default(uuid())
  phone            String           @unique
  country          String
  name             String
  businessName     String?
  currentMode      Mode             @default(PERSONAL)
  subscriptionTier SubscriptionTier @default(TRIAL)
  trialEndsAt      DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  consentSettings ConsentSettings?
  contacts        Contact[]
  campaigns       Campaign[]
  deliveryLogs    DeliveryLog[]

  @@map("users")
}

model ConsentSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  backgroundSendEnabled Boolean  @default(false)
  smsEnabled            Boolean  @default(true)
  whatsappEnabled       Boolean  @default(true)
  contactSyncEnabled    Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_settings")
}

model Contact {
  id              String            @id @default(uuid())
  userId          String
  name            String
  phone           String
  relationship    Relationship?
  modeTags        ContactModeTag[]
  occasionType    OccasionType
  occasionMonth   Int
  occasionDay     Int
  occasionYear    Int?
  businessSegment BusinessSegment?
  notes           String?
  messageTemplate String?
  source          ContactSource     @default(MANUAL)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]

  @@index([userId])
  @@map("contacts")
}

model Campaign {
  id                String            @id @default(uuid())
  userId            String
  name              String
  type              CampaignType
  scheduleFrequency ScheduleFrequency
  scheduleTime      String
  startDate         DateTime?
  endDate           DateTime?
  audienceSegment   AudienceSegment
  messageBody       String
  tone              CampaignTone?
  status            CampaignStatus    @default(DRAFT)
  nextRunAt         DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]

  @@index([userId])
  @@map("campaigns")
}

model DeliveryLog {
  id             String         @id @default(uuid())
  userId         String
  contactId      String?
  campaignId     String?
  channel        Channel
  recipientName  String
  recipientPhone String
  messageBody    String
  status         DeliveryStatus @default(PENDING)
  watermarked    Boolean        @default(false)
  sentAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("delivery_logs")
}
