# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string used by Prisma. Matches the docker-compose.yml service below.
# Host port is 5433 (not the default 5432) to avoid clashing with any native/pre-installed
# Postgres already running on this machine.
DATABASE_URL="postgresql://memora:memora@localhost:5433/memora?schema=public"

# JWT secrets — use long random strings in real environments.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Optional third-party API keys. Leave unset to use the built-in stubbed/canned fallbacks.
OPENAI_API_KEY=
TERMII_API_KEY=
WHATSAPP_API_TOKEN=

# HTTP port the Nest app listens on.
PORT=3000
